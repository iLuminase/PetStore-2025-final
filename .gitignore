# ========================
# Root .gitignore for PetStore Project
# ========================

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Environment variables
.env
.env.local
.env.*.local

# Secrets
application-secrets.yml
*-secrets.yml

# Database
*.sql.backup
*.db
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.cache

# Node modules (Frontend dependencies - very large!)
node_modules/
**/node_modules/

# Package lock files (optional - uncomment if you want to ignore)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Build outputs (will be built on deployment)
dist/
build/
out/

# Documentation build outputs
docs/_build/
site/
