{
  "name": "petstore-mfe",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:shared": "ng serve shared --port 4201",
    "start:products": "ng serve products --port 4202",
    "start:shell": "ng serve shell --port 4200",
    "start:dev": "npm run start:shared & sleep 5 && npm run start:products & sleep 5 && npm run start:shell",
    "start:all": "concurrently --restart-tries 3 \"ng serve shared --port 4201\" \"sleep 10 && ng serve products --port 4202\" \"sleep 20 && ng serve shell --port 4200\"",
    "start:sequential": "start /B ng serve shared --port 4201 && timeout /T 10 && start /B ng serve products --port 4202 && timeout /T 10 && start /B ng serve shell --port 4200",
    "build": "ng build",
    "build:shared": "ng build shared --configuration production",
    "build:products": "ng build products --configuration production",
    "build:shell": "ng build shell --configuration production",
    "build:all": "npm run build:shared && npm run build:products && npm run build:shell",
    "build:docker": "npm run build:all",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "docker:build": "docker build -t petstore-frontend .",
    "docker:run": "docker run -p 80:80 petstore-frontend"
  },
  "private": true,
  "dependencies": {
    "@angular-architects/native-federation": "^20.1.7",
    "@angular/animations": "^20.3.3",
    "@angular/cdk": "^20.2.11",
    "@angular/common": "^20.3.3",
    "@angular/compiler": "^20.3.3",
    "@angular/core": "^20.3.3",
    "@angular/forms": "^20.3.3",
    "@angular/material": "^20.2.11",
    "@angular/platform-browser": "^20.3.3",
    "@angular/platform-browser-dynamic": "^20.3.3",
    "@angular/router": "^20.3.3",
    "es-module-shims": "^2.6.2",
    "keycloak-angular": "^20.0.0",
    "keycloak-js": "^26.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.3",
    "@angular/cli": "^20.3.3",
    "@angular/compiler-cli": "^20.3.3",
    "@types/jasmine": "~5.1.0",
    "concurrently": "^8.2.2",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
